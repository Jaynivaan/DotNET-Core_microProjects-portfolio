{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Attention": {
    "DecayRate": 0.01,
    "MinimumAttentionWeight": 0.10,
    "AttentionBoost": 0.05,
    "AnchorDecayMultiplier": 0.25,
    "AnchorMinimumWeight": 0.50
  },

  "BulkIngestion": {
    "MaxInputCharacters": 200000,
    "MaxChunkCharacters": 2000,
    "ChunkOverlapCharacters": 200,
    "MaxChunksPerRequest": 150,
    "PreserveParagraphs": true,
    "ContinueOnChunkFailure": true,
    "RejectEmptyChunks" :  true
  },

  "AttentionVelocity": {
    "VelocityWindowHours": 720
  },

  "AttentionRelease": {
    "MaximumReleaseWeight": 0.2,
    "MaximumVelocityPerHour": 0.01,
    "AllowAnchorRelease": false
  },

  "AttentionInputValidation": {
    "EnableValidation": true,
    "MinimumTextLength": 2,
    "MaximumTextLength": 4000,
    "RejectWhitespacesOnly": true
  },

  "ProcessingPipeline": {
    "Enabled": true
  },

  "TextNormalization": {
    "Enabled": true
  },

  "NoiseReduction": {
    "Enabled": true,
    "Level": "Aggressive"
  },

  "KeywordExtraction": {
    "Enabled": true,
    "MinimumKeywordLength": 3,
    "MaximumKeywordLength": 50,
    "NormalizeKeywords": true
  },

  "TagExtraction": {
    "Enabled": true,
    "RulesFilePath": "Data/Tag-Rules.json"
  },

  "Crystallization": {

    "Enabled": true,
    "SlotCount": 888,
    "CentroidDimensions": 64,
    "ColdThreshold": 0.60,
    "WarmThreshold": 0.80,
    "WarmPromotionCount": 2,
    "HotPromotionCount": 4,
    "MaxSignalsPerInput": 8,
    "MaxCentroidInertia": 2

  },

  "Gravity": {
    "Enabled": true,
    "MaximumGravityFields": 1024,
    "CentroidDimensions": 128,
    "MaxDynamicTagsPerField": 64,
    "FieldFormationThreshold": 0.70,
    "ResonanceThreshold": 0.65,
    "MaximumFieldRadius": 1.0,
    "MergeThreshold": 0.90,
    "StabilityThreshold": 0.75,
    "SignedTernaryWeight": 0.70,
    "VocabularyWeight": 0.30,
    "BaseParticipatingMass": 1.0,
    "ResonanceMassWeight": 1.0,
    "EnergyMassWeight": 0.50,
    "StabilityMassWeight": 0.50,
    "MaxGravityInertia": 3,
    "MaxSemanticMass": 100.0
  },

  "VectorPreparation": {
    "Enabled": true
  },

  "PostProcessingGuard": {
    "Enabled": true
  },

  "HyperVector": {
    "Enabled": true,
    "Dimensions": 4096,
    "Sparsity": 0.67
  },

  "Resonance": {
    "Enabled": true,
    "TextWeight": 0.35,
    "HyperVectorWeight": 0.65,
    "MinimumScore" :  0.10
  }

}
