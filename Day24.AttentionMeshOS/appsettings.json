{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Attention": {
    "DecayRate": 0.01,
    "MinimumAttentionWeight": 0.10,
    "AttentionBoost": 0.05,
    "AnchorDecayMultiplier": 0.25,
    "AnchorMinimumWeight": 0.50
  },

  "AttentionVelocity": {
    "VelocityWindowHours": 720
  },

  "AttentionRelease": {
    "MaximumReleaseWeight": 0.2,
    "MaximumVelocityPerHour": 0.01,
    "AllowAnchorRelease": false
  },

  "AttentionInputValidation": {
    "EnableValidation": true,
    "MinimumTextLength": 2,
    "MaximumTextLength": 4000,
    "RejectWhitespacesOnly": true
  },

  "ProcessingPipeline": {
    "Enabled": true
  },

  "TextNormalization": {
    "Enabled" :  true
  }

}
